# =============================================================================
# cheapfirst configuration
# =============================================================================
# Metti le tue API key qui o in variabili d'ambiente.
# I provider senza chiave vengono ignorati.

provider_keys:
  deepseek: ${DEEPSEEK_API_KEY}
  anthropic: ${ANTHROPIC_API_KEY}
  openai: ${OPENAI_API_KEY}
  # groq: ${GROQ_API_KEY}
  # local: http://localhost:11434/v1    # Ollama / vLLM / llama.cpp / ds4

# ── Modelli extra (non su OpenRouter, es. locali) ─────────────────────────
models_extra:
  - id: "ollama/llama3.2"
    provider: "local"
    tier: "free"
    context_length: 8192
    pricing:
      prompt_per_m: 0
      completion_per_m: 0
    benchmarks:
      intelligence_index: 30.0
      coding_index: 35.0
      agentic_index: 20.0

  - id: "ds4-local"
    provider: "local"
    name: "ds4 (DeepSeek V4 locale)"
    tier: "free"
    context_length: 128000
    pricing:
      prompt_per_m: 0
      completion_per_m: 0
    benchmarks:
      intelligence_index: 38.0
      coding_index: 52.0
      agentic_index: 28.0

# ── Registry ─────────────────────────────────────────────────────────────
registry:
  auto_update: true
  auto_update_interval_days: 7
  path: ~/.cheapfirst/registry.json

# ── Routing ──────────────────────────────────────────────────────────────
routing:
  min_benchmark_score: 25          # Sotto questo, modello escluso per quel task
  verify: true
  max_turns: 3
  skip_verify_confidence: 0.8     # Confidenza > 80% = skip verify
  max_cost_per_request: 0.05

# ── Metriche ─────────────────────────────────────────────────────────────
metrics:
  enabled: true
  db_path: ~/.cheapfirst/metrics.db
